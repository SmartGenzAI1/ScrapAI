# ScrapAI Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
ENABLE_BACKGROUND_WORKERS=true
WORKER_INTERVAL=4

# Database Settings
DATABASE_URL=sqlite:///./scrapai.db
DB_ECHO=false

# Crawler Settings
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; ScrapAI-Bot/2.0; +https://scrapai.local)
REQUEST_DELAY=1.0
MAX_CONCURRENT=5
RESPECT_ROBOTS=true
CRAWLER_TIMEOUT=15
MAX_CRAWL_DEPTH=2
MAX_PAGES_PER_DOMAIN=50

# Semantic Embedding & Search Settings (Offline Zero-API Ready)
EMBEDDING_MODEL=local-tfidf-semantic
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=128
USE_NEURAL_EMBEDDINGS=true

# Text Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNKING_BATCH_SIZE=20
CHUNKING_METHOD=sentences

# Hybrid Search Weights
WEIGHT_SEMANTIC=0.45
WEIGHT_BM25=0.25
WEIGHT_TITLE=0.15
WEIGHT_DOMAIN=0.10
WEIGHT_FRESHNESS=0.05
SEARCH_DEFAULT_LIMIT=10
SNIPPET_LENGTH=220

# Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=
API_URL=http://localhost:8000
